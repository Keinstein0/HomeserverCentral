# Environment Configuration for Homeserver Central
# Copy this file to .env and fill in your values

# ============================================================
# Matrix / Auth Service Configuration
# ============================================================

# Matrix Homeserver URL
HOMESERVER_URL=http://tuwunel:8008

# Matrix Server Name (e.g., keinstein0.ch)
MATRIX_SERVER_NAME=keinstein0.ch

# Bot Access Token for room membership checking
# IMPORTANT: Generate this from your Matrix bot account
BOT_ACCESS_TOKEN=your_bot_access_token_here

# Secret key for signing session cookies
# IMPORTANT: Generate a random long string (e.g., openssl rand -hex 32)
GATEWAY_SECRET_KEY=your_gateway_secret_key_here

# ============================================================
# Service URLs (for client connections)
# ============================================================

# API URL for frontend (Vite/Vite dev server)
VITE_API_URL=http://localhost:5000

# ============================================================
# Development Settings
# ============================================================

# Enable debug mode for development
DEBUG=false

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
