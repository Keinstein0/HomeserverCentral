FROM node:20-alpine

# Create app directory
WORKDIR /app

# Install dependencies first (for Docker caching)
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server with host binding for container access.
# (The old `cp -r build/* /build_output/` copy was removed: /build_output was
# never created and nothing consumes it since Caddy now serves static content
# from the `homepage` nginx container instead of a shared volume.)
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]