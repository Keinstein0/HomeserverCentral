FROM node:20-alpine

# Create app directory
WORKDIR /app

# Install dependencies first (for Docker caching)
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server with host binding for container access
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]