# =============================================================================
# Homepage - production image (SvelteKit static build served by nginx)
# =============================================================================
# Build stage uses `npm ci` (locked deps) for reproducibility, matching the CI
# lint/unit steps. The runtime stage is nginx serving the static output that
# Caddy mounts from the static_build volume in dev/test; in prod compose this
# image is the `homepage` service Caddy proxies to directly.

# syntax=docker/dockerfile:1
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies first (for Docker layer caching)
COPY package.json package-lock.json ./
RUN npm ci

# Copy source code and produce the static build (adapter-static -> build/)
COPY . .
RUN npm run build

# -----------------------------------------------------------------------------
# Runtime stage - nginx serving the static bundle
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine

# Custom config: static serving, SPA fallback, immutable-asset caching
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/build /usr/share/nginx/html

EXPOSE 80

# wget (busybox, present in nginx:alpine) for the compose healthcheck
HEALTHCHECK --interval=10s --timeout=5s --retries=6 --start-period=10s \
    CMD wget -q --spider http://localhost/index.html || exit 1

CMD ["nginx", "-g", "daemon off;"]
