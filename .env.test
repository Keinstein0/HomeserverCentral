# Deterministic dummy environment for CI and local test runs.
# Loaded via:  docker compose --env-file .env.test --profile test up -d
#
# These are PUBLIC, non-secret dummy values. Safe to commit. Do NOT put
# real production secrets here (use the gitignored .env for those).

# Matrix / Auth Service
GATEWAY_SECRET_KEY=test_secret_key_12345
BOT_ACCESS_TOKEN=test_bot_token_abcde
HOMESERVER_URL=http://tuwunel:8008
MATRIX_SERVER_NAME=keinstein0.ch

# Session cookie domain (matches the prod default; fine over HTTP in tests).
COOKIE_DOMAIN=.keinstein0.ch

# Caddy: disable automatic HTTPS so local/test runs serve plain HTTP on
# http://localhost without cert provision attempts or timeouts.
AUTO_HTTPS=off

# Status API cache: short TTL so integration tests for cache behaviour
# (INT-STA-04, INT-STA-05) complete quickly without long waits.
CACHE_TTL_SECONDS=2
